;; Dependencies are kept in sync with project.clj while both build tools are
;; supported (dual mode). Versions deliberately match project.clj, except for the
;; lein-only tools.reader pin documented there.
{:paths ["src/clj" "config/defaults" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.10.1"}

        ;; HTTP
        clj-http/clj-http {:mvn/version "3.10.0"}
        compojure/compojure {:mvn/version "1.6.2"}
        ring/ring {:mvn/version "1.8.2"}
        cheshire/cheshire {:mvn/version "5.10.0"}
        metosin/ring-http-response {:mvn/version "0.9.1"}
        metosin/muuntaja {:mvn/version "0.6.7"}

        ;; Config
        yogthos/config {:mvn/version "1.1.7"}

        ;; Logging
        com.taoensso/timbre {:mvn/version "4.10.0"}
        com.fzakaria/slf4j-timbre {:mvn/version "0.3.19"}

        ;; Utility libraries
        org.apache.commons/commons-compress {:mvn/version "1.27.1"}

        ;; InterMine assets
        ;; Git dependency until imcljs 1.7.0 is on Clojars (the last release there is 1.6.0);
        ;; then switch back to {:mvn/version "1.7.0"}. project.clj (lein) cannot use git
        ;; dependencies and stays on the last Clojars release. tools.build leaves git
        ;; dependencies out of the pom, so a SNAPSHOT jar built now does not name imcljs.
        org.intermine/imcljs {:git/url "https://github.com/gmicklem/imcljs.git"
                              :git/sha "98c0f103bbb87812c8f948c7d7478ad349298957"}} ; 1.7.0-SNAPSHOT

 :aliases
 {;; clojure -M:test
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}

  ;; clojure -M:dev -m bluegenes-tool-store.core   (config/dev is git-ignored, local overrides)
  :dev {:extra-paths ["config/dev"]
        :jvm-opts ["-Ddevelopment=true"]}

  ;; clojure -M:prod -m bluegenes-tool-store.core  (config/prod is git-ignored, local overrides)
  :prod {:extra-paths ["config/prod"]}

  ;; clojure -T:build jar | install | uber | clean
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}}}
